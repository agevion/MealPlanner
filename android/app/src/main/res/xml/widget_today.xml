<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis="0": Android no lo refresca solo. Lo repinta la app cada
  vez que sales de ella, que es cuando el widget se va a ver; despertar el
  proceso cada media hora solo gastaría batería.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:description="@string/widget_today_description"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_card"
    android:previewLayout="@layout/widget_card"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
